<Window x:Class="RdpMonitorSwitcher.Views.CertificateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zertifikat prüfen" SizeToContent="Height" Width="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="Headline" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Explanation" TextWrapping="Wrap" Margin="0,8,0,12" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Host:" Margin="0,2,12,2" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HostText" TextWrapping="Wrap" Margin="0,2" />
            <TextBlock Grid.Row="1" Text="Ausgestellt für:" Margin="0,2,12,2" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SubjectText" TextWrapping="Wrap" Margin="0,2" />
            <TextBlock Grid.Row="2" Text="Aussteller:" Margin="0,2,12,2" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="IssuerText" TextWrapping="Wrap" Margin="0,2" />
            <TextBlock Grid.Row="3" Text="Fingerabdruck:" Margin="0,2,12,2" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="FingerprintText" IsReadOnly="True" TextWrapping="Wrap"
                     BorderThickness="0" Background="Transparent" FontFamily="Consolas" Margin="0,2" />
            <TextBlock Grid.Row="4" x:Name="OldLabel" Text="Bisher:" Margin="0,2,12,2" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="OldFingerprintText" IsReadOnly="True" TextWrapping="Wrap"
                     BorderThickness="0" Background="Transparent" FontFamily="Consolas" Margin="0,2" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Immer vertrauen" MinWidth="110" Padding="10,4" Margin="0,0,8,0" Click="OnAlways" />
            <Button Content="Nur dieses Mal" MinWidth="110" Padding="10,4" Margin="0,0,8,0" Click="OnOnce" />
            <Button Content="Abbrechen" IsCancel="True" IsDefault="True" MinWidth="96" Padding="10,4" />
        </StackPanel>
    </StackPanel>
</Window>
