<Window x:Class="RdpMonitorSwitcher.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einstellungen" SizeToContent="Height" Width="500" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="16">
        <TextBlock Text="Dateien vom Remote-PC herausziehen" FontSize="15" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Margin="0,6,0,10" Foreground="#555">
            Ziehe Dateien im Explorer des Remote-PCs wie gewohnt. Erreicht der Mauszeiger dabei die Zone am Rand
            (oder drückst du <Run FontWeight="SemiBold">Strg+Alt+D</Run>), werden die Dateien über die RDP-Verbindung geholt
            und du ziehst sie auf deinem lokalen PC weiter – z. B. auf den Desktop oder in einen Explorer-Ordner.
            Ohne gedrückte Maustaste legt Strg+Alt+D die markierten Dateien in die lokale Zwischenablage.
        </TextBlock>

        <CheckBox x:Name="EnabledBox" Content="Automatische Zone am Rand aktivieren" Margin="0,0,0,8" Checked="OnEnabledChanged" Unchecked="OnEnabledChanged" />

        <Grid x:Name="ZoneOptions" Margin="20,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Rand:" VerticalAlignment="Center" Margin="0,4,12,4" />
            <ComboBox x:Name="EdgeBox" Grid.Column="1" Margin="0,4" Width="160" HorizontalAlignment="Left">
                <ComboBoxItem Content="Rechts" />
                <ComboBoxItem Content="Links" />
                <ComboBoxItem Content="Oben" />
                <ComboBoxItem Content="Unten" />
            </ComboBox>
            <TextBlock Grid.Row="1" Text="Breite der Zone:" VerticalAlignment="Center" Margin="0,4,12,4" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                <Slider x:Name="SizeSlider" Width="180" Minimum="4" Maximum="120" TickFrequency="4" IsSnapToTickEnabled="True" />
                <TextBlock Text="{Binding Value, ElementName=SizeSlider, StringFormat={}{0:0} px}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Row="2" Text="Verzögerung:" VerticalAlignment="Center" Margin="0,4,12,4" />
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                <Slider x:Name="DelaySlider" Width="180" Minimum="0" Maximum="1500" TickFrequency="50" IsSnapToTickEnabled="True"
                        ToolTip="So lange muss die Maustaste gedrückt sein, bevor die Zone auslöst (verhindert versehentliches Auslösen bei Klicks am Rand)." />
                <TextBlock Text="{Binding Value, ElementName=DelaySlider, StringFormat={}{0:0} ms}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11" Foreground="Gray"
                   Text="Voraussetzung: „Zwischenablage teilen“ ist in der Verbindung aktiviert. Die Zone gilt für jedes Remote-Fenster (auch die separaten Monitorfenster); auch Ziehen über den Fensterrand hinaus löst sie aus." />

        <Separator Margin="0,16" />

        <TextBlock Text="Anordnung der Remote-Monitore" FontSize="15" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Margin="0,6,0,10" Foreground="#555">
            Legt fest, auf welcher Seite von Monitor 1 die weiteren Monitore des Remote-PCs liegen – also in welche Richtung
            du ein Fenster über den Bildschirmrand ziehst, um es auf Monitor 2 zu bringen. Stelle es so ein, wie du die
            Monitorfenster auf deinem PC angeordnet hast.
        </TextBlock>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Monitor 2, 3, … liegen" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="ArrangementBox" Width="200">
                <ComboBoxItem Content="rechts von Monitor 1" />
                <ComboBoxItem Content="links von Monitor 1" />
            </ComboBox>
        </StackPanel>
        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11" Foreground="Gray"
                   Text="Während einer Verbindung wird sie dafür kurz neu aufgebaut; geöffnete Programme bleiben erhalten." />

        <Separator Margin="0,16" />

        <TextBlock Text="Monitor automatisch wechseln" FontSize="15" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Margin="0,6,0,10" Foreground="#555">
            Klickst du im Remote-PC z. B. ein Programm in der Taskleiste an, zeigt das Hauptfenster automatisch den Monitor,
            auf dem das Programm im Vordergrund ist. Ist der Monitor schon in einem Fenster zu sehen, passiert nichts.
        </TextBlock>
        <CheckBox x:Name="FollowBox" Content="Zum Monitor des aktiven Fensters wechseln" Margin="0,0,0,6" />
        <TextBlock x:Name="RemoteHelperStatus" TextWrapping="Wrap" Margin="20,0,0,0" FontSize="12" />

        <Separator Margin="0,16" />

        <TextBlock Text="Hilfsprogramm auf dem Remote-PC" FontSize="15" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Margin="0,6,0,10" Foreground="#555">
            Der automatische Wechsel braucht ein kleines Hilfsprogramm auf dem PC, der ferngesteuert wird: ohne Fenster,
            startet mit Windows, keine Adminrechte, meldet nur, auf welchem Monitor das aktive Fenster liegt.
            Kopiere diese App auf den Remote-PC, öffne sie dort einmal und klicke dort auf diesen Knopf:
        </TextBlock>
        <StackPanel Orientation="Horizontal">
            <Button x:Name="HelperButton" MinWidth="96" Padding="10,4" Click="OnToggleHelper" />
            <TextBlock x:Name="LocalHelperStatus" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Speichern" IsDefault="True" MinWidth="96" Padding="10,4" Margin="0,0,8,0" Click="OnSave" />
            <Button Content="Abbrechen" IsCancel="True" MinWidth="96" Padding="10,4" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
