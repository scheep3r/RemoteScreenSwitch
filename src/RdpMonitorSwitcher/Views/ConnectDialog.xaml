<Window x:Class="RdpMonitorSwitcher.Views.ConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verbindung" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="16" Width="480">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,12,0" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="3" />
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="Padding" Value="3" />
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <Style TargetType="CheckBox">
                <Setter Property="Margin" Value="0,3" />
            </Style>
            <Style TargetType="RadioButton">
                <Setter Property="Margin" Value="0,3" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Remote-PC:" />
        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="70" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="HostBox" IsEditable="True" SelectionChanged="OnRecentSelected"
                      ToolTip="Hostname, IP-Adresse, Tailscale-IP (100.x.y.z) oder MagicDNS-Name" />
            <TextBlock Grid.Column="1" Text="Port:" Margin="8,0,6,0" />
            <TextBox x:Name="PortBox" Grid.Column="2" />
        </Grid>
        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" Foreground="Gray" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="z. B. büro-pc, 192.168.1.20 oder über Tailscale 100.64.1.5 / büro-pc.tailnet.ts.net" />

        <TextBlock Grid.Row="2" Text="Benutzer:" />
        <TextBox x:Name="UserBox" Grid.Row="2" Grid.Column="1" ToolTip="Benutzername, DOMÄNE\Benutzer oder benutzer@domäne" />

        <TextBlock Grid.Row="3" Text="Passwort:" />
        <PasswordBox x:Name="PasswordBox" Grid.Row="3" Grid.Column="1" />

        <CheckBox x:Name="SavePasswordBox" Grid.Row="4" Grid.Column="1">
            <TextBlock TextWrapping="Wrap" Margin="0"
                       Text="Passwort speichern (verschlüsselt in der Windows-Anmeldeinformationsverwaltung)" />
        </CheckBox>

        <Separator Grid.Row="5" Grid.ColumnSpan="2" Margin="0,8" />

        <TextBlock Grid.Row="6" Text="Monitore:" VerticalAlignment="Top" Margin="0,4,12,0" />
        <StackPanel Grid.Row="6" Grid.Column="1">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="FitModeBox" GroupName="Mode" Content="An Fenster anpassen, Anzahl:" Checked="OnModeChanged" />
                <ComboBox x:Name="CountBox" Width="60" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock FontSize="11" Foreground="Gray" Margin="20,0,0,4" TextWrapping="Wrap"
                       Text="Jeder Remote-Monitor erhält die Größe des Fensters, in dem er angezeigt wird – keine schwarzen Ränder." />
            <RadioButton x:Name="FixedModeBox" GroupName="Mode" Content="Feste Auflösungen (links nach rechts, erster = Hauptmonitor):"
                         Checked="OnModeChanged" />
            <TextBox x:Name="ResolutionsBox" Margin="20,3,0,3" ToolTip="z. B. 1920x1080, 2560x1440, 1920x1080" />
        </StackPanel>

        <TextBlock Grid.Row="7" Text="Anzeige:" />
        <ComboBox x:Name="ScalingBox" Grid.Row="7" Grid.Column="1">
            <ComboBoxItem Content="An Fenster anpassen" />
            <ComboBoxItem Content="Originalgröße (1:1, mit Scrollen)" />
        </ComboBox>

        <TextBlock Grid.Row="8" Text="Remote-Skalierung:" />
        <ComboBox x:Name="RemoteScalingBox" Grid.Row="8" Grid.Column="1" />

        <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,6,0,0">
            <CheckBox x:Name="ClipboardBox" Content="Zwischenablage (Text) teilen" />
            <CheckBox x:Name="AudioBox" Content="Ton des Remote-PCs abspielen" />
            <CheckBox x:Name="H264Box" Content="H.264-Videokompression (weniger Bandbreite)" />
            <CheckBox x:Name="ReconnectBox" Content="Bei Verbindungsabbruch automatisch neu verbinden" />
        </StackPanel>

        <Expander x:Name="WakeExpander" Grid.Row="10" Grid.ColumnSpan="2" Margin="0,10,0,0"
                  Header="PC aus der Ferne einschalten (Wake-on-LAN)">
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Methode:" />
                <ComboBox x:Name="WakeMethodBox" Grid.Column="1" SelectionChanged="OnWakeMethodChanged">
                    <ComboBoxItem Content="Aus" />
                    <ComboBoxItem Content="Über die FRITZ!Box (funktioniert auch von unterwegs)" />
                    <ComboBoxItem Content="Magic Packet (nur im selben Netzwerk)" />
                </ComboBox>

                <TextBlock x:Name="FritzAddressLabel" Grid.Row="1" Text="FRITZ!Box:" />
                <TextBox x:Name="FritzAddressBox" Grid.Row="1" Grid.Column="1"
                         ToolTip="Im Heimnetz: fritz.box. Von unterwegs: MyFRITZ!-Adresse mit HTTPS-Port, z. B. abc123xyz.myfritz.net:44312" />
                <TextBlock x:Name="FritzAddressHint" Grid.Row="2" Grid.Column="1" FontSize="11" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"
                           Text="Im Heimnetz „fritz.box“. Von unterwegs die MyFRITZ!-Adresse mit Port (FRITZ!Box → Internet → MyFRITZ!-Konto bzw. Freigaben → FRITZ!Box-Dienste)." />
                <TextBlock x:Name="FritzUserLabel" Grid.Row="3" Text="Benutzer:" />
                <TextBox x:Name="FritzUserBox" Grid.Row="3" Grid.Column="1" ToolTip="FRITZ!Box-Benutzer mit dem Recht „FRITZ!Box Einstellungen“" />
                <TextBlock x:Name="FritzPasswordLabel" Grid.Row="4" Text="Passwort:" />
                <StackPanel x:Name="FritzPasswordRow" Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <PasswordBox x:Name="FritzPasswordBox" Width="200" />
                    <Button x:Name="LoadDevicesButton" Content="Geräte laden" Margin="8,3,0,3" Padding="10,2" Click="OnLoadDevices" />
                </StackPanel>
                <TextBlock x:Name="DevicesLabel" Grid.Row="5" Text="Gerät:" />
                <ComboBox x:Name="DevicesBox" Grid.Row="5" Grid.Column="1" SelectionChanged="OnDeviceSelected"
                          DisplayMemberPath="Display" ToolTip="Wähle den Remote-PC – die MAC-Adresse wird übernommen." />

                <TextBlock Grid.Row="6" Text="MAC-Adresse:" />
                <TextBox x:Name="MacBox" Grid.Row="6" Grid.Column="1" ToolTip="Netzwerkkarte des Remote-PCs, z. B. 00-11-22-AA-BB-CC" />
                <TextBlock x:Name="WakeStatusText" Grid.Row="7" Grid.ColumnSpan="2" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            </Grid>
        </Expander>

        <TextBlock x:Name="ErrorText" Grid.Row="11" Grid.ColumnSpan="2" Foreground="#B3261E" TextWrapping="Wrap"
                   Margin="0,8,0,0" Visibility="Collapsed" />

        <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Verbinden" IsDefault="True" MinWidth="96" Padding="10,4" Margin="0,0,8,0" Click="OnConnect" />
            <Button Content="Abbrechen" IsCancel="True" MinWidth="96" Padding="10,4" />
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
