<Window x:Class="RdpMonitorSwitcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RdpMonitorSwitcher.Views"
        Title="{Binding WindowTitle}"
        Width="1280" Height="800" MinWidth="640" MinHeight="420"
        Background="#FF1B1B1B" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Remote screen -->
        <views:RemoteViewport x:Name="Viewport" Grid.Row="1" />

        <!-- Overlay while not connected -->
        <Border Grid.Row="1" Background="#E61B1B1B"
                Visibility="{Binding ShowOverlay, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- MinHeight = viewport: centered while it fits, scrollable from the top when it doesn't -->
            <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="720" Margin="16,24">
                <TextBlock Text="{Binding OverlayText}" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Style="{StaticResource AccentToolButton}" Content="Verbinden …" Padding="16,6"
                            Command="{Binding ConnectCommand}"
                            Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource ToolButton}" Content="⏻ PC aufwecken &amp; verbinden" Padding="16,6" Margin="8,0,0,0"
                            Command="{Binding WakeAndConnectCommand}"
                            Visibility="{Binding CanWake, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="Schaltet den Remote-PC per Wake-on-LAN ein, wartet bis er hochgefahren ist und verbindet dann." />
                    <Button Style="{StaticResource ToolButton}" Content="Abbrechen" Padding="16,6"
                            Command="{Binding CancelWakeCommand}"
                            Visibility="{Binding IsWaking, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource ToolButton}" Content="Abbrechen" Padding="16,6"
                            Command="{Binding CancelReconnectCommand}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Setup guide: how the remote PC can be reached -->
                <views:SetupGuide Margin="0,32,0,0"
                                  Visibility="{Binding ShowSetupGuide, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- Error / notice banners -->
        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24" MaxWidth="720">
            <Border x:Name="ErrorBanner" Background="{StaticResource ErrorBrush}" CornerRadius="6" Padding="12,8" Margin="0,4"
                    Visibility="{Binding MainView.ErrorMessage, Converter={x:Static views:Converters.NotNullToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="✕" Command="{Binding MainView.DismissErrorCommand}" />
                    <TextBlock Text="{Binding MainView.ErrorMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <Border x:Name="NoticeBanner" Background="#FF33415C" CornerRadius="6" Padding="12,8" Margin="0,4"
                    Visibility="{Binding Notice, Converter={x:Static views:Converters.NotNullToVisibility}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="✕" Command="{Binding DismissNoticeCommand}" />
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </StackPanel>

        <!-- Hot zone at the top edge that reveals a hidden toolbar -->
        <Border x:Name="HotZone" Grid.Row="1" Height="4" VerticalAlignment="Top" Background="#01000000" />

        <!-- Toolbar -->
        <Border x:Name="Toolbar" Grid.Row="0" Background="{StaticResource ToolbarBrush}"
                BorderBrush="{StaticResource ToolbarBorderBrush}" BorderThickness="0,0,0,1" Padding="6,4"
                Panel.ZIndex="10">
            <DockPanel LastChildFill="False">
                <!-- connection -->
                <Border DockPanel.Dock="Left" CornerRadius="12" Padding="10,3" Margin="0,0,6,0" Background="#FF383838"
                        VerticalAlignment="Center" ToolTip="{Binding StatusDetail}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,7,0" Fill="{Binding State, Converter={x:Static views:Converters.StateToBrush}}" />
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button DockPanel.Dock="Left" Style="{StaticResource AccentToolButton}" Content="{Binding ConnectButtonText}"
                        Command="{Binding ConnectOrDisconnectCommand}" ToolTip="Verbindung herstellen oder trennen" />
                <Border DockPanel.Dock="Left" Style="{StaticResource ToolSeparator}" />

                <!-- monitor selection -->
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="◀"
                        Command="{Binding MainView.PreviousMonitorCommand}" IsEnabled="{Binding MainView.HasMultipleMonitors}"
                        ToolTip="Vorheriger Monitor (Strg+Alt+←)" />
                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding MainView.MonitorButtons}"
                              ItemTemplate="{StaticResource MonitorButtonTemplate}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="▶"
                        Command="{Binding MainView.NextMonitorCommand}" IsEnabled="{Binding MainView.HasMultipleMonitors}"
                        ToolTip="Nächster Monitor (Strg+Alt+→)" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="＋" Command="{Binding AddMonitorCommand}"
                        IsEnabled="{Binding IsConnected}" ToolTip="Remote-Monitor hinzufügen" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="－" Command="{Binding RemoveMonitorCommand}"
                        IsEnabled="{Binding IsConnected}" ToolTip="Remote-Monitor entfernen" />
                <Border DockPanel.Dock="Left" Style="{StaticResource ToolSeparator}" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="⧉ Fenster je Monitor"
                        Command="{Binding OpenAllMonitorWindowsCommand}" IsEnabled="{Binding IsConnected}"
                        ToolTip="Jeden weiteren Remote-Monitor in einem eigenen, frei verschiebbaren Fenster öffnen (Strg+Alt+M)" />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="⇩ Dateien holen"
                        Command="{Binding PullRemoteFilesCommand}" IsEnabled="{Binding CanPullFiles}"
                        ToolTip="Im Remote-Explorer markierte Dateien in die lokale Zwischenablage holen (Strg+Alt+D). Beim Ziehen: an den Rand ziehen oder Strg+Alt+D drücken." />
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolButton}" Content="Fenster schließen"
                        Command="{Binding CloseAllMonitorWindowsCommand}"
                        Visibility="{Binding IsMultiWindow, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="Alle separaten Monitorfenster schließen" />

                <!-- view options (right) -->
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="?" Click="OnHelp"
                        ToolTip="Tastenkürzel" />
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="⟳" Click="OnCheckUpdates"
                        ToolTip="Nach Updates suchen" />
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="⚙" Click="OnSettings"
                        ToolTip="Einstellungen (Datei-Zone, Monitoranordnung, Monitor automatisch wechseln)" />
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Strg+Alt+Entf"
                        Command="{Binding SendCtrlAltDelCommand}" IsEnabled="{Binding IsConnected}"
                        ToolTip="Strg+Alt+Entf an den Remote-PC senden (Strg+Alt+Ende)" />
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding MainView.ToggleFullscreenCommand}"
                        ToolTip="Vollbild (Strg+Alt+Enter)">
                    <TextBlock Text="{Binding MainView.IsFullscreen, Converter={x:Static views:Converters.FullscreenLabel}}" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Command="{Binding MainView.ToggleScalingCommand}"
                        ToolTip="Zwischen „an Fenster anpassen“ und Originalgröße (1:1) umschalten">
                    <TextBlock Text="{Binding MainView.Scaling, Converter={x:Static views:Converters.ScalingLabel}}" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="▲" FontSize="10"
                        Command="{Binding MainView.ToggleToolbarCommand}" ToolTip="Toolbar ausblenden (Strg+Alt+T)" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
