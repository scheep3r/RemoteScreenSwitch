<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>RDP Monitor Switcher</AssemblyTitle>
    <Product>RDP Monitor Switcher</Product>
    <Version>1.3.0</Version>
    <UpdateRepository>scheep3r/RemoteScreenSwitch</UpdateRepository>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Built by native/RdpBridge/build.cmd -->
    <RdpBridgePath>$(MSBuildThisFileDirectory)..\..\native\RdpBridge\out\install\x64-release\bin\RdpBridge.dll</RdpBridgePath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RdpBridgePath)" Link="RdpBridge.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('$(RdpBridgePath)')" />
  </ItemGroup>

  <Target Name="WarnMissingRdpBridge" BeforeTargets="Build" Condition="!Exists('$(RdpBridgePath)')">
    <Warning Text="RdpBridge.dll not found at $(RdpBridgePath). Run native\RdpBridge\build.cmd first; the app cannot connect without it." />
  </Target>

  <ItemGroup>
    <!-- GitHub repository ("owner/name") whose releases the update button installs. Empty = updates off. -->
    <AssemblyMetadata Include="UpdateRepository" Value="$(UpdateRepository)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RdpMonitorSwitcher.Core\RdpMonitorSwitcher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
