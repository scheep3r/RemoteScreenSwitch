<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <RdpBridgePath>$(MSBuildThisFileDirectory)..\..\native\RdpBridge\out\install\x64-release\bin\RdpBridge.dll</RdpBridgePath>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RdpBridgePath)" Link="RdpBridge.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(RdpBridgePath)')" />
  </ItemGroup>

</Project>
